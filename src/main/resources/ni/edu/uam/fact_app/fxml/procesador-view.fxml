<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="408.0" prefWidth="470.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicahilos.practicahilosjavafx.ProcesadorController">
    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>

    <Label style="-fx-font-size: 22px;" text="Procesando Datos de las DB" />

    <Label fx:id="lblEstado">
      <font>
         <Font name="Berlin Sans FB" size="12.0" />
      </font></Label>

    <ProgressBar fx:id="barraProgresoProductos" prefWidth="420" progress="0" />

    <Label fx:id="lblPorcentajeProductos" text="0%" />

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnIniciarProductos" onAction="#iniciarProceso" text="Procesar">
         <font>
            <Font name="Berlin Sans FB" size="12.0" />
         </font></Button>

        <Button fx:id="btnDetenerProductos" disable="true" onAction="#detenerProceso" text="Detener">
         <font>
            <Font name="Berlin Sans FB" size="12.0" />
         </font></Button>

        <Button fx:id="btnReiniciarProductos" onAction="#reiniciarProceso" text="Restablecer">
         <font>
            <Font name="Berlin Sans FB" size="12.0" />
         </font></Button>
    </HBox>
   <ProgressBar fx:id="barraProgresoCategorias" layoutX="35.0" layoutY="208.0" prefWidth="420" progress="0" />
   <Label fx:id="lblPorcentajeCategorias" layoutX="236.0" layoutY="247.0" text="0%" />
   <HBox alignment="CENTER" layoutX="35.0" layoutY="284.0" spacing="10">
      <children>
         <Button fx:id="btnIniciarCategorias" onAction="#iniciarProceso" text="Procesar">
            <font>
               <Font name="Berlin Sans FB" size="12.0" />
            </font>
         </Button>
         <Button fx:id="btnDetenerCategorias" disable="true" onAction="#detenerProceso" text="Detener">
            <font>
               <Font name="Berlin Sans FB" size="12.0" />
            </font>
         </Button>
         <Button fx:id="btnReiniciarCategorias" onAction="#reiniciarProceso" text="Restablecer">
            <font>
               <Font name="Berlin Sans FB" size="12.0" />
            </font>
         </Button>
      </children>
   </HBox>
</VBox>
